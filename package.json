{
  "name": "@ai-hero/cookout",
  "version": "0.9.0",
  "description": "A self-hosted, Slack-style board where people and agents share channels and threads.",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "cookout": "./dist/main.js"
  },
  "files": [
    "dist",
    "docs/agents.md",
    "skills"
  ],
  "exports": {
    "./sdk": "./app/modules/sdk/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattpocock/cookout.git"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./sdk": {
        "types": "./dist/sdk.d.ts",
        "default": "./dist/sdk.js"
      }
    }
  },
  "scripts": {
    "dev": "node app/dev.ts start",
    "seed": "node app/dev.ts seed",
    "build": "tsdown --log-level warn && vite build",
    "api": "node scripts/api-report.ts",
    "api:write": "node scripts/api-report.ts --write",
    "exports": "node scripts/check-exports.ts",
    "render": "node scripts/check-render-yaml.ts",
    "pack:smoke": "node scripts/pack-smoke.ts",
    "published-client": "node scripts/published-client.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "e2e:docker": "scripts/e2e-docker.sh",
    "new-cloud-worker": "scripts/new-cloud-worker.sh",
    "check": "node scripts/check.ts",
    "fix": "knip --production --include exports,types,dependencies --fix > /dev/null; node scripts/lint-ratchet.ts --fix > /dev/null 2>&1; biome format --write . > /dev/null && node scripts/lint-ratchet.ts",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "node scripts/lint-ratchet.ts",
    "lint:changed": "node scripts/lint-changed.ts",
    "lint-config": "node scripts/lint-config.ts",
    "lint:baseline": "node scripts/lint-ratchet.ts --write",
    "canaries": "node scripts/canaries.ts",
    "fixers": "node scripts/check-fixers.ts",
    "seams": "depcruise app packages/handler-example scripts --cache node_modules/.cache/depcruise && depcruise packages/e2e/app --config packages/e2e/.dependency-cruiser.mjs --cache node_modules/.cache/depcruise-e2e",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false .",
    "knip": "knip --production --include exports,types,files,dependencies",
    "docs": "node scripts/check-docs.ts",
    "validators": "node scripts/generate-validators.ts",
    "validators:check": "node scripts/generate-validators.ts --check",
    "hygiene": "node scripts/hygiene.ts",
    "merge-ticket": "node scripts/merge-ticket.ts",
    "ci:wait": "node scripts/ci-wait.ts",
    "test": "vitest run --coverage",
    "test:related": "vitest related --run --passWithNoTests",
    "test:shard": "vitest run --coverage --reporter=blob --reporter=default --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
    "test:merge": "vitest run --merge-reports --coverage",
    "coverage:changed": "node scripts/coverage-changed.ts",
    "coverage:unstable": "node scripts/coverage-unstable.ts",
    "under-load": "node scripts/under-load.ts",
    "web:slow": "node scripts/web-slow.ts",
    "coverage:raise": "vitest run --coverage --coverage.thresholds.autoUpdate=true",
    "test:watch": "vitest",
    "browser": "playwright test",
    "browser:flaky": "node scripts/browser-flaky.ts",
    "browser:slow": "node scripts/browser-slow.ts",
    "browser:coverage": "COOKOUT_BROWSER_COVERAGE=.browser-coverage/records node scripts/browser-coverage.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.5",
    "@effect/sql-pg": "^4.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "effect": "^4.1.5",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@swc/core": "^1.16.22",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "^18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "unified": "^11.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
